# Copie para .env e preencha com os valores do projeto hospedado.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Login com Google (opcional; sem elas o botão do Google não aparece).
# IDs de cliente OAuth do Google Cloud: o "Web" (também vai no Supabase) e o "iOS".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
