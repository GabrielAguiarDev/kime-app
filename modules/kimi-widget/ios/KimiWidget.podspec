Pod::Spec.new do |s|
  s.name           = 'KimiWidget'
  s.version        = '1.0.0'
  s.summary        = 'Storage shared with the Kimi widgets (App Group), widget reloads and the native round timer engine.'
  s.description    = s.summary
  s.license        = 'UNLICENSED'
  s.author         = 'Kimi'
  s.homepage       = 'https://kimi.app'
  s.platforms      = { :ios => '16.4' }
  s.swift_version  = '5.9'
  s.source         = { git: '' }
  s.static_framework = true

  s.dependency 'ExpoModulesCore'
  s.frameworks = 'WidgetKit', 'ActivityKit', 'AVFoundation'
  # Round timer bells (generated by scripts/sounds/generate.py, CC0).
  s.resource_bundles = { 'KimiWidgetSounds' => ['sounds/*.wav'] }

  s.source_files = '**/*.{h,m,swift}'
  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
    'SWIFT_COMPILATION_MODE' => 'wholemodule'
  }
end
