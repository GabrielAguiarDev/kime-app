{
  "name": "kimi",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo-google-fonts/barlow-condensed": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/ui": "58.0.27",
    "@shopify/restyle": "2.4.5",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.3",
    "expo": "58.0.23",
    "expo-apple-authentication": "58.0.2",
    "expo-asset": "58.0.20",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.18",
    "expo-image-manipulator": "58.0.16",
    "expo-image-picker": "58.0.10",
    "expo-keep-awake": "58.0.3",
    "expo-linking": "58.0.16",
    "expo-notifications": "58.1.8",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.22",
    "expo-splash-screen": "58.0.13",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "phosphor-react-native": "3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "supabase": "3.0.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "android": "expo run:android --device",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --remote --schema public > types/database.ts",
    "test": "jest",
    "tokens": "node scripts/tokens/generate.mjs",
    "tokens:check": "node scripts/tokens/generate.mjs --check"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/supabase/",
      "<rootDir>/ios/",
      "<rootDir>/android/"
    ],
    "moduleNameMapper": {
      "^@components$": "<rootDir>/src/components",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@domain/(.*)$": "<rootDir>/src/domain/$1",
      "^@infra$": "<rootDir>/src/infra",
      "^@infra/(.*)$": "<rootDir>/src/infra/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@theme$": "<rootDir>/src/theme",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1"
    }
  }
}
