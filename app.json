{
  "expo": {
    "name": "Kimi",
    "slug": "kimi",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/kimi-icon-light.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.kimi.app",
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/brand/kimi-icon-light.png",
        "dark": "./assets/brand/kimi-icon-dark.png",
        "tinted": "./assets/brand/kimi-icon-tinted.png"
      },
      "appleTeamId": "B4CXCRNV44",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.br.com.kimi.app"
        ]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.kimi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-apple-authentication",
      "expo-image",
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Kimi usa suas fotos para você escolher sua foto de perfil e a logo da academia.",
          "cameraPermission": "O Kimi usa a câmera para você tirar sua foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Kimi usa a câmera para ler o QR code da TV.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "scheme": "kimi",
    "experiments": {
      "typedRoutes": true
    }
  }
}
